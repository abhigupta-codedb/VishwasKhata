rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUserUid() {
      return request.auth.uid;
    }

    // Safely get the lowercased email from auth token
    function currentUserEmail() {
      return (isAuthenticated() && request.auth.token.email != null)
        ? request.auth.token.email.lower()
        : '';
    }

    // Bootstrap administrator (Directly matches owner account regardless of token casing)
    function isBootstrapAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'mayank.abhishekgupta@gmail.com' ||
        request.auth.token.email == 'Mayank.abhishekgupta@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'mayank.abhishekgupta@gmail.com')
      );
    }

    // Safe document existence checker in allowed_users
    function checkAllowedDoc(emailOrUid) {
      return emailOrUid != '' && exists(/databases/$(database)/documents/allowed_users/$(emailOrUid));
    }

    // Safe admin role checker in allowed_users
    function checkAdminDoc(emailOrUid) {
      return emailOrUid != '' &&
        exists(/databases/$(database)/documents/allowed_users/$(emailOrUid)) &&
        get(/databases/$(database)/documents/allowed_users/$(emailOrUid)).data.get('role', '') == 'admin';
    }

    // 1. ALLOWLIST ENFORCEMENT: Check if the user is approved in allowed_users or is bootstrap admin
    function isAllowedUser() {
      return isAuthenticated() && (
        isBootstrapAdmin() ||
        checkAllowedDoc(currentUserEmail()) ||
        checkAllowedDoc(currentUserUid())
      );
    }

    // Check if user has administrator privileges to manage the allowlist
    function isAdmin() {
      return isAuthenticated() && (
        isBootstrapAdmin() ||
        checkAdminDoc(currentUserEmail()) ||
        checkAdminDoc(currentUserUid())
      );
    }

    // Check if user is owner of the project document
    function isProjectOwnerData(projectData) {
      return projectData != null && projectData.ownerUid != null && projectData.ownerUid == currentUserUid();
    }

    // Check if the given project document grants membership to the current user
    function isProjectMemberData(projectData) {
      return isAllowedUser() && projectData != null && (
        // Owner UID matches
        isProjectOwnerData(projectData) ||
        // UID in authorizedUserUids list
        (projectData.authorizedUserUids != null && currentUserUid() in projectData.authorizedUserUids) ||
        // Email matches authorizedEmails list
        (currentUserEmail() != '' && projectData.authorizedEmails != null && currentUserEmail() in projectData.authorizedEmails)
      );
    }

    // 2. PROJECT-LEVEL ISOLATION: Reusable helper isProjectMember(projectId)
    function isProjectMember(projectId) {
      return isAllowedUser() &&
        projectId != null &&
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        isProjectMemberData(get(/databases/$(database)/documents/projects/$(projectId)).data);
    }

    // Check if user is project owner by projectId
    function isProjectOwner(projectId) {
      return isAllowedUser() &&
        projectId != null &&
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        isProjectOwnerData(get(/databases/$(database)/documents/projects/$(projectId)).data);
    }

    // Check if an invited partner is linking their own authenticated UID to their authorized email seat
    function isClaimingAuthorizedEmail(prevData, nextData) {
      return currentUserEmail() != '' &&
        prevData.authorizedEmails != null &&
        currentUserEmail() in prevData.authorizedEmails &&
        nextData.ownerUid == prevData.ownerUid &&
        nextData.currency == prevData.currency &&
        nextData.defaultApprovalThreshold == prevData.defaultApprovalThreshold &&
        nextData.authorizedEmails == prevData.authorizedEmails;
    }

    // -------------------------------------------------------------
    // Allowed Users Collection (Invite-Only Gatekeeper)
    // -------------------------------------------------------------
    match /allowed_users/{userEmail} {
      // Individual user can verify their own allowlist entry during login check, or admin can read
      allow get: if isAuthenticated() && (
        isBootstrapAdmin() ||
        isAdmin() ||
        (currentUserEmail() != '' && currentUserEmail() == userEmail.lower()) ||
        currentUserUid() == userEmail
      );

      // List query: Only admin can view the entire allowlist
      allow list: if isAdmin();

      // Bootstrap admin or any admin can add or edit approved users
      allow create, update: if (isBootstrapAdmin() || isAdmin()) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 3 &&
        request.resource.data.email.size() <= 150;

      // Bootstrap admin or any admin can remove approved users
      allow delete: if isBootstrapAdmin() || isAdmin();
    }

    // -------------------------------------------------------------
    // Users Collection (Private per UID, Gated to Allowed Users)
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if isAllowedUser() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------
    // Projects Collection (Multi-Tenancy & Project-Level Isolation)
    // -------------------------------------------------------------
    match /projects/{projectId} {
      // Read: Can only read if allowed user and registered member of this project
      allow get: if isAllowedUser() && isProjectMemberData(resource.data);
      allow list: if isAllowedUser() && isProjectMemberData(resource.data);

      // Create: Signed-in allowed user can create a project where they are set as ownerUid
      allow create: if isAllowedUser() &&
        request.resource.data.ownerUid == currentUserUid();

      // Update: Registered member only
      allow update: if isAllowedUser() && isProjectMemberData(resource.data) && (
        isProjectOwnerData(resource.data) ||
        isClaimingAuthorizedEmail(resource.data, request.resource.data) ||
        // If sensitive governance fields change, caller MUST be the project owner
        (
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.authorizedUserUids == resource.data.authorizedUserUids &&
          request.resource.data.authorizedEmails == resource.data.authorizedEmails &&
          request.resource.data.partners == resource.data.partners &&
          request.resource.data.defaultApprovalThreshold == resource.data.defaultApprovalThreshold &&
          request.resource.data.currency == resource.data.currency
        )
      );

      // Delete: Only project owner can delete
      allow delete: if isAllowedUser() && isProjectOwnerData(resource.data);

      // Subcollections (members, entries, approvals, comments, attachments, amendments, notifications)
      match /{allSubcollections=**} {
        allow read, write: if isProjectMember(projectId);
      }
    }

    // -------------------------------------------------------------
    // Entries Collection (Top-Level, Project-Scoped Isolation)
    // -------------------------------------------------------------
    match /entries/{entryId} {
      // Read: Allowed only if user is an authorized member of the parent project
      allow read: if resource.data.projectId != null && isProjectMember(resource.data.projectId);

      // Create: Allowed only if user is a member of the target project and createdByUid matches
      allow create: if request.resource.data.projectId != null &&
        isProjectMember(request.resource.data.projectId) &&
        (
          request.resource.data.createdByUid == null ||
          request.resource.data.createdByUid == currentUserUid()
        );

      // Update: Authorized project members only, enforce immutability on approved entries
      allow update: if resource.data.projectId != null &&
        isProjectMember(resource.data.projectId) &&
        request.resource.data.projectId == resource.data.projectId &&
        (
          // If already approved, protect financial fields from direct overwriting unless through an amendment
          resource.data.status != 'approved' ||
          (
            request.resource.data.amendments != null &&
            request.resource.data.amendments.size() > resource.data.amendments.size()
          ) ||
          // Comments or attachment additions allowed
          (
            request.resource.data.amount == resource.data.amount &&
            request.resource.data.type == resource.data.type &&
            request.resource.data.date == resource.data.date &&
            request.resource.data.payerPartnerId == resource.data.payerPartnerId &&
            request.resource.data.recipientPartnerId == resource.data.recipientPartnerId
          )
        );

      // Delete: Only unapproved drafts or pending records can be deleted by creator or owner
      allow delete: if resource.data.projectId != null &&
        isProjectMember(resource.data.projectId) &&
        resource.data.status != 'approved' &&
        (
          resource.data.createdByUid == currentUserUid() ||
          isProjectOwner(resource.data.projectId)
        );
    }

    // -------------------------------------------------------------
    // Audit Logs Collection (Top-Level, Project-Scoped Isolation)
    // -------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if resource.data.projectId != null && isProjectMember(resource.data.projectId);

      // Create: Actor must be the authenticated member of the project
      allow create: if request.resource.data.projectId != null &&
        isProjectMember(request.resource.data.projectId) &&
        (
          request.resource.data.actorUid == null ||
          request.resource.data.actorUid == currentUserUid()
        );

      // Strictly append-only
      allow update, delete: if false;
    }

    // -------------------------------------------------------------
    // Notifications Collection (User- or Project-Scoped)
    // -------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read, delete: if isAllowedUser() && (
        (resource.data.recipientUid != null && resource.data.recipientUid == currentUserUid()) ||
        (currentUserEmail() != '' && resource.data.recipientEmail != null && resource.data.recipientEmail == currentUserEmail()) ||
        (resource.data.projectId != null && isProjectMember(resource.data.projectId))
      );

      allow create: if isAllowedUser() && (
        request.resource.data.projectId == null ||
        isProjectMember(request.resource.data.projectId)
      );

      allow update: if isAllowedUser() && (
        resource.data.recipientUid == currentUserUid() ||
        (currentUserEmail() != '' && resource.data.recipientEmail == currentUserEmail())
      );
    }

    // -------------------------------------------------------------
    // Deny-by-default for any unmapped collections
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
