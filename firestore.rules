rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUserUid() {
      return request.auth.uid;
    }

    function currentUserEmail() {
      return request.auth.token.email;
    }

    function isAnonymousUser() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Check if user is owner of the project document
    function isProjectOwnerData(projectData) {
      return projectData.ownerUid != null && projectData.ownerUid == currentUserUid();
    }

    // Check if the current user has access to a project document
    function isProjectAuthorized(projectData) {
      return (
        // Demo project flag allows demo / anonymous exploration only for demo data
        (projectData.isDemo == true && isAnonymousUser()) ||
        // Real authenticated user access
        (!isAnonymousUser() && (
          // Owner UID matches
          isProjectOwnerData(projectData) ||
          // UID in authorizedUserUids list
          (projectData.authorizedUserUids != null && currentUserUid() in projectData.authorizedUserUids) ||
          // Email matches authorizedEmails list
          (currentUserEmail() != null && projectData.authorizedEmails != null && currentUserEmail() in projectData.authorizedEmails)
        ))
      );
    }

    // Check project authorization via get() fetch
    function canAccessParentProject(projectId) {
      let parentProj = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return parentProj != null && isProjectAuthorized(parentProj);
    }

    // Check if user is project owner via get() fetch
    function isParentProjectOwner(projectId) {
      let parentProj = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return parentProj != null && isProjectOwnerData(parentProj);
    }

    // Check if an invited partner is linking their own authenticated UID to their authorized email seat
    function isClaimingAuthorizedEmail(prevData, nextData) {
      return currentUserEmail() != null &&
        prevData.authorizedEmails != null &&
        currentUserEmail() in prevData.authorizedEmails &&
        nextData.ownerUid == prevData.ownerUid &&
        nextData.currency == prevData.currency &&
        nextData.defaultApprovalThreshold == prevData.defaultApprovalThreshold &&
        nextData.authorizedEmails == prevData.authorizedEmails;
    }

    // -------------------------------------------------------------
    // Users Collection (Private per UID)
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------
    // Projects Collection (Multi-Tenancy Enforced)
    // -------------------------------------------------------------
    match /projects/{projectId} {
      // Read: Can only read if authorized for this specific project
      allow read: if isAuthenticated() && isProjectAuthorized(resource.data);

      // Create: Signed-in user can create a project where they are set as ownerUid
      allow create: if isAuthenticated() && (
        (isAnonymousUser() && request.resource.data.isDemo == true) ||
        (!isAnonymousUser() && request.resource.data.ownerUid == currentUserUid())
      );

      // Update:
      // Sensitive operations (partners, authorization lists, approval thresholds, currency) require OWNER permission,
      // EXCEPT when an invited partner claims their seat matching their authenticated email.
      allow update: if isAuthenticated() && isProjectAuthorized(resource.data) && (
        isProjectOwnerData(resource.data) ||
        (resource.data.isDemo == true && isAnonymousUser()) ||
        isClaimingAuthorizedEmail(resource.data, request.resource.data) ||
        // If sensitive governance fields change, caller MUST be the project owner
        (
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.authorizedUserUids == resource.data.authorizedUserUids &&
          request.resource.data.authorizedEmails == resource.data.authorizedEmails &&
          request.resource.data.partners == resource.data.partners &&
          request.resource.data.defaultApprovalThreshold == resource.data.defaultApprovalThreshold &&
          request.resource.data.currency == resource.data.currency
        )
      );

      // Delete: Only owner can delete the project
      allow delete: if isAuthenticated() && (
        isProjectOwnerData(resource.data) ||
        (resource.data.isDemo == true && isAnonymousUser())
      );

      // Nested sub-collections if any (inherit project authorization)
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && canAccessParentProject(projectId);
      }
    }

    // -------------------------------------------------------------
    // Entries Collection (Linked to Project Multi-Tenancy & Immutability)
    // -------------------------------------------------------------
    match /entries/{entryId} {
      // Read: Allowed only if user is authorized for the parent project
      allow read: if isAuthenticated() && (
        resource.data.projectId != null && canAccessParentProject(resource.data.projectId)
      );

      // Create: Allowed only if user is authorized for target project and createdByUid matches
      allow create: if isAuthenticated() && (
        request.resource.data.projectId != null &&
        canAccessParentProject(request.resource.data.projectId) &&
        (isAnonymousUser() || request.resource.data.createdByUid == currentUserUid())
      );

      // Update: Authorized members only, enforce immutability on approved entries
      allow update: if isAuthenticated() && (
        resource.data.projectId != null &&
        canAccessParentProject(resource.data.projectId) &&
        request.resource.data.projectId == resource.data.projectId &&
        // If already approved, protect financial fields from direct overwriting unless through an amendment
        (
          resource.data.status != 'approved' ||
          (
            request.resource.data.amendments != null &&
            request.resource.data.amendments.size() > resource.data.amendments.size()
          ) ||
          // Comments or attachment metadata additions allowed
          (
            request.resource.data.amount == resource.data.amount &&
            request.resource.data.type == resource.data.type &&
            request.resource.data.date == resource.data.date &&
            request.resource.data.payerPartnerId == resource.data.payerPartnerId &&
            request.resource.data.recipientPartnerId == resource.data.recipientPartnerId
          )
        )
      );

      // Delete: Only unapproved drafts or pending records can be deleted by creator or owner
      allow delete: if isAuthenticated() && (
        resource.data.status != 'approved' &&
        resource.data.projectId != null &&
        (
          isAnonymousUser() ||
          resource.data.createdByUid == currentUserUid() ||
          isParentProjectOwner(resource.data.projectId)
        )
      );
    }

    // -------------------------------------------------------------
    // Audit Logs Collection (Append-Only, Project Scoped)
    // -------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && (
        resource.data.projectId != null && canAccessParentProject(resource.data.projectId)
      );

      // Create: Actor must be the authenticated user
      allow create: if isAuthenticated() && (
        request.resource.data.projectId != null &&
        canAccessParentProject(request.resource.data.projectId) &&
        (isAnonymousUser() || request.resource.data.actorUid == currentUserUid())
      );

      // Strictly append-only: no edits or deletions permitted
      allow update, delete: if false;
    }
  }
}
